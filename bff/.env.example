DEEPSEEK_API_KEY=sk-your-key-here
JWT_SECRET=youjing-bff-secret-change-in-prod
PORT=3000
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com/v1
# json_schema（默认，结构化输出）| json_object（上游不支持 json_schema 时降级）
LLM_RESPONSE_FORMAT=json_schema
# 数据库位置（容器/云函数请指到挂载卷；留空则用 data/youjing.db）
# DB_PATH=/data/youjing.db

# ── 收据校验（D1–D4）。三项任一缺失时 /v1/iap/verify 一律 503（fail-closed）──
# IAP_VERIFY_URL 填「完整校验端点」；请求体 {purchaseToken, productType, appId}、
# Authorization: Bearer <IAP_VERIFY_TOKEN>、成功响应 { "verified": true }。
# 接华为官方订单校验 API 时需按官方文档对表（当前契约是我方与校验服务之间的）。
# IAP_VERIFY_URL=https://orders-drcn.iap.cloud.huawei.com.cn/<verify-path>
# IAP_APP_ID=
# IAP_VERIFY_TOKEN=

# ── 华为 IAP 服务端通知验签（D7）。未配置时 /v1/iap/notify 一律 503 ──
# 公钥来自 AppGallery Connect 控制台，PEM 文本。多行可写成一行并用 \n 转义。
# IAP_NOTIFY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# ── 设备激活的华为身份验签（D10）。未配置 HUAWEI_CLIENT_ID 时带身份的激活一律 401 ──
# Client ID 来自 AGC（与 APP ID 相同：6917619826312400726）。
# 默认使用官方 JWKS 与 issuer，一般无需改；私有化/测试环境可覆盖。
HUAWEI_CLIENT_ID=6917619826312400726
# HUAWEI_JWKS_URL=https://oauth-login.cloud.huawei.com/oauth2/v3/certs
# HUAWEI_ISSUER=https://accounts.huawei.com

# LLM 上游单次调用超时（毫秒）；超时按 504 失败并释放额度，不把幂等行卡在 pending
# LLM_TIMEOUT_MS=45000

# 生成接口的账号级限流（进程内存；多实例各算一份，跨实例限流需共享存储）
# RATE_LIMIT_PER_MINUTE=10
# RATE_LIMIT_WINDOW_MS=60000
