DEEPSEEK_API_KEY=sk-your-key-here
JWT_SECRET=youjing-bff-secret-change-in-prod
PORT=3000
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com/v1
# json_schema（默认，结构化输出）| json_object（上游不支持 json_schema 时降级）
LLM_RESPONSE_FORMAT=json_schema
# 数据库位置（容器/云函数请指到挂载卷；留空则用 data/youjing.db）
# DB_PATH=/data/youjing.db

# ── 收据校验与关键事件通知（对表华为官方 2026-09，JWS 本地验签）──
# 客户端上报 jwsPurchaseOrder / jwsSubscriptionStatus（官方 PurchaseData 里的 JWS），
# 服务端用 Huawei CBG Root CA G2 证书链本地验签 + ES256 + 叶子 OID 检查（src/services/iapJws.js）。
# 通知体为 {jwsNotification}（v3），与收据同一套验签；未配置时两个入口一律 fail-closed。
# IAP_APP_ID = AGC 的 Client ID / APP ID（如 6917619826312400726），用于收据 applicationId 比对。
IAP_APP_ID=
# 根证书默认 certs/RootCaG2Ecdsa.cer（已入库）；容器挂载卷时可覆盖：
# IAP_ROOT_CERT_PATH=/data/certs/RootCaG2Ecdsa.cer
# 沙盒/开发单不花钱，默认一律拒收（只认 environment=Production）。
# 真机沙盒验收时临时打开这一行，验收完删掉——开着它 preflight 会出警告，不算可对外。
# IAP_ALLOW_SANDBOX=1

# ── 设备激活的华为身份验签（D10）。未配置 HUAWEI_CLIENT_ID 时带身份的激活一律 401 ──
# Client ID 来自 AGC（与 APP ID 相同：6917619826312400726）。
# 默认使用官方 JWKS 与 issuer，一般无需改；私有化/测试环境可覆盖。
HUAWEI_CLIENT_ID=6917619826312400726
# HUAWEI_JWKS_URL=https://oauth-login.cloud.huawei.com/oauth2/v3/certs
# HUAWEI_ISSUER=https://accounts.huawei.com

# LLM 上游单次调用超时（毫秒）；超时按 504 失败并释放额度，不把幂等行卡在 pending
# LLM_TIMEOUT_MS=45000

# 生成接口的账号级限流（进程内存；多实例各算一份，跨实例限流需共享存储）
# RATE_LIMIT_PER_MINUTE=10
# RATE_LIMIT_WINDOW_MS=60000

# ── 管理员账号（本机联调无限生成额度）──
# 填 account.id（逗号分隔），命中后 /v1/trip/generate 不再回 402，权益下发 unlimited=true。
# 查 id：sqlite3 data/youjing.db "SELECT id, union_id, device_id, last_seen_at FROM account;"
# 未设置 = 功能关闭；导出付费墙、IAP、限流不受影响。
# ADMIN_ACCOUNT_IDS=3
