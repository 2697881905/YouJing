{
  "insightIntents": [
    {
      "intentName": "PlanTrip",
      "domain": "TravelDomain",
      "intentVersion": "1.0.0",
      "srcEntry": "./ets/insight/PlanTripExecutor.ets",
      "uiAbility": {
        "ability": "EntryAbility",
        "executeMode": [
          "foreground"
        ]
      },
      "displayName": "规划行程",
      "displayDescription": "按目的地、日期、人数与天数生成旅行行程",
      "keywords": [
        "旅行",
        "行程",
        "规划",
        "攻略",
        "出游"
      ],
      "inputParams": [
        { "name": "destination", "type": "string", "required": false, "description": "目的地城市（北京/上海/广州/深圳）" },
        { "name": "start", "type": "string", "required": false, "description": "出发日期 YYYY-MM-DD" },
        { "name": "end", "type": "string", "required": false, "description": "返程日期 YYYY-MM-DD" },
        { "name": "days", "type": "number", "required": false, "description": "天数（含首尾），给出时反算返程日" },
        { "name": "people", "type": "number", "required": false, "description": "同行人数" },
        { "name": "route", "type": "string", "required": false, "description": "落点屏名，缺省 TripInput" }
      ],
      "outputParams": [
        { "name": "accepted", "type": "boolean", "description": "参数是否被接受并预填" },
        { "name": "destination", "type": "string", "description": "回显已接受的目的地城市" }
      ]
    }
  ],
  "insightIntentsSrcEntry": [
    {
      "srcEntry": "./ets/insight/PlanTripExecutor.ets"
    }
  ]
}
