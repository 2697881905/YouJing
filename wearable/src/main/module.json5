{
  "module": {
    "name": "wearable",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "WatchAbility",
    "deviceTypes": [
      "wearable"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    // 全网络客户端：手表独立 HTTPS 访问 BFF（G0-N-a/f）
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO"
      }
    ],
    // 同 bundle 的手表入口也声明 client_id：Wear Engine 客户端在手表侧同样会校验
    "metadata": [
      {
        "name": "client_id",
        "value": "6917619826312400726"
      }
    ],
    "abilities": [
      {
        "name": "WatchAbility",
        "srcEntry": "./ets/entryability/WatchAbility.ets",
        "description": "$string:WatchAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:WatchAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          }
        ]
      }
    ]
  }
}
